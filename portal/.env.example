# Own Apache VPS: keep this service behind 127.0.0.1:3107.
# Staging remains NOINDEX and robots-disallowed by default.
PUBLIC_LAUNCH_APPROVED=false
NEXT_PUBLIC_SITE_URL=
CONTACT_EMAIL=
# Require actual operator details and legal approval BEFORE launch:
SITE_OPERATOR_NAME=
SITE_OPERATOR_ADDRESS=
SITE_OPERATOR_EMAIL=
# Full legally reviewed actual public content, not a boilerplate template:
SITE_IMPRINT_EXTRA=
SITE_PRIVACY_NOTICE=
LEGAL_CONTENT_REVIEWED=false
DEPLOYMENT_SECURITY_APPROVED=false
