# EXAMPLE ONLY. Root-owned 0600 at /etc/lowhangingfruitme/api.env.
# Do not place real credentials or signing keys in the Git repository.
# The API's actual runtime preflight rejects missing or unsafe values.
LHFM_DB_HOST=127.0.0.1
LHFM_DB_PORT=3306
LHFM_DB_USER=
LHFM_DB_PASSWORD=
LHFM_DB_NAME=
LHFM_API_SOURCE_ROOT=/var/lib/lowhangingfruitme/private-sources
LHFM_UPLOAD_ROOT=/var/lib/lowhangingfruitme/private-uploads
LHFM_CLAMD_UNIX_SOCKET=/run/clamav/clamd.ctl
LHFM_DOCLING_SANDBOX_LAUNCHER=/usr/local/libexec/lowhangingfruitme/docling-sandbox-launcher
LHFM_DOCLING_CACHE_HOME=/srv/lowhangingfruitme/docling-models
LHFM_OIDC_ISSUER=
LHFM_OIDC_AUDIENCE=
LHFM_OIDC_JWKS_FILE=/etc/lowhangingfruitme/oidc-public.jwks
LHFM_OIDC_ALLOWED_CLIENT_IDS=
LHFM_APPROVAL_KEY_HEX=
