# REVIEWED TEMPLATE ONLY. Do NOT run as root or enable on an unverified VPS.
# Requires a dedicated lhfm-api UID, distinct from Apache and portal accounts.
# Local MariaDB, clamd, offline Docling models, root-owned sandbox launcher.
[Unit]
Description=LowHangingFruitMe private financial API (loopback only)
After=network-online.target mariadb.service clamav-daemon.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=lhfm-api
Group=lhfm-api
WorkingDirectory=/srv/lowhangingfruitme
EnvironmentFile=/etc/lowhangingfruitme/api.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/srv/lowhangingfruitme/python/bin/lhfm-runtime-check
ExecStart=/srv/lowhangingfruitme/python/bin/python -m uvicorn lowhangingfruitme.api.http:create_app_from_environment --factory --host 127.0.0.1 --port 8127 --workers 1 --no-proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lowhangingfruitme/private-uploads
ReadOnlyPaths=/var/lib/lowhangingfruitme/private-sources
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
LimitNOFILE=1024
TasksMax=150

[Install]
WantedBy=multi-user.target
