{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LowHangingFruitMe source-controls v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "supplier_id",
    "agreement_id",
    "period_start",
    "period_end",
    "transactions",
    "settlements"
  ],
  "properties": {
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1
    },
    "agreement_id": {
      "type": "string",
      "minLength": 1
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "transactions": {
      "$ref": "#/$defs/control"
    },
    "settlements": {
      "$ref": "#/$defs/control"
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "net_total",
        "source_reference"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "net_total": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$"
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
